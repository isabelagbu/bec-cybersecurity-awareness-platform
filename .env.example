# Firebase config - fill these in from your Firebase project settings
# (Project settings > General > Your apps > SDK setup and configuration)
# Copy this file to .env.local and fill in real values there.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: admin usernames are signed in as <username>@<this domain> in Firebase Auth.
# Defaults to admin.bec-training.app if left blank.
VITE_ADMIN_EMAIL_DOMAIN=
